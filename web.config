<configuration><system.webServer><directoryBrowse enabled="false"/><security><requestFiltering><hiddenSegments>
<add segment="src"/><add segment="var"/><add segment="Cache"/><add segment="tests"/><add segment="tools"/><add segment="includes"/><add segment="class"/><add segment="_readable-source"/>
</hiddenSegments><fileExtensions><add fileExtension=".bak" allowed="false"/><add fileExtension=".zip" allowed="false"/><add fileExtension=".sql" allowed="false"/><add fileExtension=".log" allowed="false"/></fileExtensions><denyUrlSequences><add sequence="config.php"/><add sequence="install.lock"/><add sequence=".htaccess"/></denyUrlSequences></requestFiltering></security></system.webServer></configuration>
